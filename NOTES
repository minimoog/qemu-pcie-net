Build qemu:


git clone https://github.com/qemu/qemu.git
cd qemu
git submodule update --init --recursive


mkdir build && cd build
../configure --target-list=x86_64-softmmu
ninja



Build buildroot:

make qemu_x86_64_defconfig
make -j$(nproc)

(deselect host qemu in  make menuconfig)




start qemu:

/build/qemu-system-x86_64 \
  -M q35 \
  -m 512M \
  -enable-kvm \
  -device mynet-pci \
  -kernel buildroot/output/images/bzImage \
  -drive file=buildroot/output/images/rootfs.ext2,if=virtio,format=raw \
  -append "root=/dev/vda console=ttyS0" \
  -nographic


./qemu-system-x86_64 \
  -M q35 \
  -m 512M \
  -enable-kvm \
  -device mynet-pci \
  -kernel ~/Developer/buildroot/output/images/bzImage \
  -drive file=~/Developer/buildroot/output/images/rootfs.ext2,if=virtio,format=raw \
  -append "root=/dev/vda console=ttyS0" \
  -fsdev local,id=fsdev0,path=/home/minimoog/Developer/qemu-pcie-net/linux-driver,security_model=none \
  -device virtio-9p-pci,fsdev=fsdev0,mount_tag=hostshare \
  -nographic


  Add to buildroot config:

  Symbol: NET_9P [=n]
Type  : tristate
Prompt: Plan 9 Resource Sharing Support (9P2000)
  Location:
    -> Networking support (NET [=y])
      -> Networking options
Symbol: 9P_FS [=y]
  Location:
    -> File systems
      -> Network File Systems (NETWORK_FILESYSTEMS [=y])
Symbol: NET_9P_VIRTIO [=n]
  Depends on: NET_9P [=n] && VIRTIO


Mount shared directory in qemu and insmod the driver:

mkdir -p /mnt/host
mount -t 9p -o trans=virtio,version=9p2000.L hostshare /mnt/host
insmod /mnt/host/mynet_drv.ko


buildroot needs msi-x enabled:

Symbol: PCI_MSI [=y]                                                                                                                                   │  
  │ Type  : bool                                                                                                                                           │  
  │ Defined at drivers/pci/Kconfig:45                                                                                                                      │  
  │   Prompt: Message Signaled Interrupts (MSI and MSI-X)                                                                                                  │  
  │   Depends on: PCI [=y]                                                                                                                                 │  
  │   Location:                                                                                                                                            │  
  │     -> Device Drivers                                                                                                                                  │  
  │       -> PCI support (PCI [=y])                                                                                                                        │  
  │ (1)     -> Message Signaled Interrupts (MSI and MSI-X) (PCI_MSI [=y])                                                                                  │  
  │ Selects: GENERIC_MSI_IRQ [=y]                                                                                                                          │  
  │ Selected by [n]:                                                                                                                                       │  
  │   - AMD_IOMMU [=n] && IOMMU_SUPPORT [=y] && X86_64 [=y] && PCI [=y] && ACPI [=y] && HAVE_CMPXCHG_DOUBLE [=y]                                           │  
  │   - ARM_GIC_V2M [=n] && PCI [=y]                                                                                                                       │  
  │   - ARMADA_370_XP_IRQ [=n] && PCI [=y]                                                                                                                 │  
  │   - ALPINE_MSI [=n] && PCI [=y]                                                                                                                        │  
  │   - LOONGSON_PCH_MSI [=n] && MACH_LOONGSON64 && PCI [=y]                                                                                               │  
  │   - SOPHGO_SG2042_MSI [=n] && (ARCH_SOPHGO || COMPILE_TEST [=n]) && PCI [=y]    


  
./qemu-system-x86_64 \
  -M q35 \
  -m 512M \
  -enable-kvm \
  -device mynet-pci,netdev=n0 \
  -kernel ~/Developer/buildroot/output/images/bzImage \
  -drive file=~/Developer/buildroot/output/images/rootfs.ext2,if=virtio,format=raw \
  -append "root=/dev/vda console=ttyS0" \
  -fsdev local,id=fsdev0,path=/home/minimoog/Developer/qemu-pcie-net/linux-driver,security_model=none \
  -device virtio-9p-pci,fsdev=fsdev0,mount_tag=hostshare \
  -netdev user,id=n0 \
  -nographic


to dump network packets

./qemu-system-x86_64 \
  -M q35 \
  -m 512M \
  -enable-kvm \
  -device mynet-pci,netdev=n0 \
  -kernel ~/Developer/buildroot/output/images/bzImage \
  -drive file=~/Developer/buildroot/output/images/rootfs.ext2,if=virtio,format=raw \
  -append "root=/dev/vda console=ttyS0" \
  -fsdev local,id=fsdev0,path=/home/minimoog/Developer/qemu-pcie-net/linux-driver,security_model=none \
  -device virtio-9p-pci,fsdev=fsdev0,mount_tag=hostshare \
  -netdev user,id=n0 \
  -object filter-dump,id=dump0,netdev=n0,file=/tmp/mynet.pcap \
  -nographic



sudo ip tuntap add dev tap0 mode tap user $(whoami)
sudo ip addr add 192.168.100.1/24 dev tap0
sudo ip link set tap0 up


sudo iptables -t nat -A POSTROUTING -s 192.168.111.0/24 -o wlp6s0 -j MASQUERADE
sudo iptables -A FORWARD -i tap0 -o wlp6s0 -j ACCEPT
sudo iptables -A FORWARD -i wlp6s0  -o tap0 -m state --state RELATED,ESTABLISHED -j ACCEPT


./qemu-system-x86_64 \
  -M q35 -m 512M -enable-kvm \
  -device mynet-pci,netdev=n0 \
  -netdev tap,id=n0,ifname=tap0,script,downscript \
  -kernel ~/Developer/buildroot/output/images/bzImage \
  -drive file=~/Developer/buildroot/output/images/rootfs.ext2,if=virtio,format=raw \
  -append "root=/dev/vda console=ttyS0" \
  -fsdev local,id=fsdev0,path=/home/minimoog/Developer/qemu-pcie-net/linux-driver,security_model=none \
  -device virtio-9p-pci,fsdev=fsdev0,mount_tag=hostshare \
  -nographic


